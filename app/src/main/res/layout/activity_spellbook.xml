<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/ink">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/screen_padding">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/spellbook_eyebrow" android:textColor="@color/gold"
            android:textSize="@dimen/label_size" android:letterSpacing="0.16" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/spellbook_title" android:textColor="@color/cream"
            android:textSize="@dimen/title_size" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:layout_marginBottom="22dp" android:text="@string/spellbook_subtitle"
            android:textColor="@color/muted" android:textSize="@dimen/body_size" />
        <Button android:id="@+id/btnLumos" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginBottom="10dp" android:background="@drawable/bg_card" android:text="@string/spell_lumos"
            android:textColor="@color/cream" android:textAllCaps="false" />
        <Button android:id="@+id/btnAccio" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginBottom="10dp" android:background="@drawable/bg_card" android:text="@string/spell_accio"
            android:textColor="@color/cream" android:textAllCaps="false" />
        <Button android:id="@+id/btnReparo" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginBottom="10dp" android:background="@drawable/bg_card" android:text="@string/spell_reparo"
            android:textColor="@color/cream" android:textAllCaps="false" />
        <Button android:id="@+id/btnWingardium" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginBottom="16dp" android:background="@drawable/bg_card" android:text="@string/spell_wingardium"
            android:textColor="@color/cream" android:textAllCaps="false" />
        <TextView android:id="@+id/tvSpellInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="88dp" android:gravity="center_vertical" android:padding="18dp"
            android:background="@drawable/bg_card" android:text="@string/spell_choose_hint"
            android:textColor="@color/gold" android:textSize="@dimen/body_size" />
        <Button android:id="@+id/btnBack" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="20dp" android:background="@drawable/bg_button_outline"
            android:text="@string/back_to_welcome" android:textColor="@color/cream" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
