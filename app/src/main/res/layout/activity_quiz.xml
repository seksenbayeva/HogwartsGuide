<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/ink">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_vertical" android:padding="@dimen/screen_padding">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/quiz_eyebrow" android:textColor="@color/gold"
            android:textSize="@dimen/label_size" android:letterSpacing="0.16" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/quiz_title" android:textColor="@color/cream"
            android:textSize="@dimen/title_size" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="26dp" android:layout_marginBottom="18dp" android:padding="20dp"
            android:background="@drawable/bg_card" android:text="@string/quiz_question"
            android:textColor="@color/cream" android:textSize="@dimen/body_size" android:lineSpacingExtra="3dp" />
        <Button android:id="@+id/btnAnswerAccio" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginBottom="10dp" android:background="@drawable/bg_card" android:text="@string/quiz_answer_accio"
            android:textColor="@color/cream" android:textAllCaps="false" />
        <Button android:id="@+id/btnAnswerLumos" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginBottom="10dp" android:background="@drawable/bg_card" android:text="@string/quiz_answer_lumos"
            android:textColor="@color/cream" android:textAllCaps="false" />
        <Button android:id="@+id/btnAnswerReparo" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginBottom="16dp" android:background="@drawable/bg_card" android:text="@string/quiz_answer_reparo"
            android:textColor="@color/cream" android:textAllCaps="false" />
        <TextView android:id="@+id/tvQuizResult" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:gravity="center" android:textColor="@color/gold" android:textSize="16sp" />
        <Button android:id="@+id/btnTryAgain" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="12dp" android:background="@drawable/bg_button" android:text="@string/quiz_try_again"
            android:textColor="@color/ink" android:textStyle="bold" android:textAllCaps="false" />
        <Button android:id="@+id/btnBack" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginTop="10dp" android:background="@drawable/bg_button_outline"
            android:text="@string/back_to_welcome" android:textColor="@color/cream" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
