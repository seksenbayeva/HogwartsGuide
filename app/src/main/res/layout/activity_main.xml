<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/ink">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_vertical"
        android:padding="@dimen/screen_padding">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="✦" android:textColor="@color/gold" android:textSize="34sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="@string/eyebrow" android:textColor="@color/gold"
            android:textSize="@dimen/label_size" android:letterSpacing="0.18" />
        <TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="@string/main_title" android:textColor="@color/cream"
            android:textSize="@dimen/title_size" android:textStyle="bold" android:lineSpacingExtra="2dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="@string/main_subtitle" android:textColor="@color/muted"
            android:textSize="@dimen/body_size" android:lineSpacingExtra="4dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="36dp" android:text="@string/name_label" android:textColor="@color/cream"
            android:textStyle="bold" android:textSize="14sp" />
        <EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:paddingStart="16dp"
            android:paddingEnd="16dp" android:hint="@string/name_hint" android:textColor="@color/cream"
            android:textColorHint="@color/muted" android:inputType="textPersonName" android:singleLine="true" />
        <Button android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="58dp"
            android:layout_marginTop="18dp" android:background="@drawable/bg_button" android:text="@string/start_button"
            android:textColor="@color/ink" android:textStyle="bold" android:textAllCaps="false" />
        <Button android:id="@+id/btnSpellbook" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginTop="12dp" android:background="@drawable/bg_button_outline" android:text="@string/spellbook_button"
            android:textColor="@color/cream" android:textAllCaps="false" />
        <Button android:id="@+id/btnQuiz" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginTop="10dp" android:background="@drawable/bg_button_outline" android:text="@string/quiz_button"
            android:textColor="@color/cream" android:textAllCaps="false" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:layout_marginTop="28dp"
            android:text="HOGWARTS  ✧  SINCE 1890" android:textColor="@color/muted" android:textSize="11sp" android:letterSpacing="0.1" />
    </LinearLayout>
</ScrollView>
